' =========================
' RESET & BASE
' =========================
!theme plain
!pragma layout smetana

skinparam backgroundColor #FFFFFF
skinparam dpi 150
skinparam shadowing false
skinparam roundcorner 10

' =========================
' FONT
' =========================
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam defaultFontColor #222222

' =========================
' COULEURS PRINCIPALES
' =========================
!define MAIN #1F4E79
!define GRAY #6C7A89
!define LIGHT_BLUE #DCEEFF
!define LIGHT #EEF3F8
!define BG #F9FBFD

' =========================
' TITRES
' =========================
skinparam titleFontSize 18
skinparam titleFontColor MAIN

' =========================
' FLÈCHES (GLOBAL)
' =========================
skinparam ArrowColor MAIN
skinparam ArrowThickness 1.5
skinparam ArrowFontSize 13
skinparam ArrowFontColor MAIN
skinparam ArrowFontStyle bold

skinparam linetype ortho
skinparam nodesep 60
skinparam ranksep 60

' =========================
' CLASSES (RÉFÉRENCE VISUELLE)
' =========================
skinparam classAttributeIconSize 0
hide circle

skinparam class {
    BackgroundColor BG
    BorderColor MAIN
    FontColor #222222

    AttributeFontColor #444444
    MethodFontColor #444444

    FontSize 14
    AttributeFontSize 13
    MethodFontSize 13

    BorderThickness 1.5
    DividerColor #D0D7E2
    HeaderBackgroundColor LIGHT_BLUE
}

' =========================
' SEQUENCE DIAGRAM
' =========================
skinparam sequence {
    ArrowColor MAIN
    LifeLineBorderColor MAIN
    LifeLineBackgroundColor LIGHT_BLUE

    ParticipantBorderColor MAIN
    ParticipantBackgroundColor LIGHT_BLUE
    ParticipantFontColor #222222

    ActorBorderColor MAIN
    ActorBackgroundColor LIGHT_BLUE

    ActivationBackgroundColor #E6EEF8
    ActivationBorderColor MAIN
}

' =========================
' STYLE UNIFIÉ (comme classes)
' =========================
skinparam component {
    BackgroundColor BG
    BorderColor MAIN
    FontColor #222222
    BorderThickness 1.5
}

skinparam rectangle {
    BackgroundColor BG
    BorderColor MAIN
    FontColor #222222
    BorderThickness 1.5
}

skinparam node {
    BackgroundColor BG
    BorderColor MAIN
    FontColor #222222
    BorderThickness 1.5
}

skinparam database {
    BackgroundColor BG
    BorderColor MAIN
    FontColor #222222
    BorderThickness 1.5
}

skinparam usecase {
    BackgroundColor BG
    BorderColor MAIN
    FontColor #222222
    BorderThickness 1.5
}

' =========================
' PACKAGES
' =========================
skinparam package {
    BorderColor MAIN
    BackgroundColor LIGHT
    FontColor MAIN
    BorderThickness 1.5
}

' =========================
' ACTIVITY DIAGRAM
' =========================
skinparam activity {
    BackgroundColor BG
    BorderColor MAIN
    FontColor #222222

    DiamondBackgroundColor LIGHT
    DiamondBorderColor MAIN
}

' =========================
' NOTES
' =========================
skinparam note {
    BackgroundColor LIGHT
    BorderColor GRAY
    FontColor #222222
}

' =========================
' LEGEND
' =========================
skinparam legend {
    BackgroundColor #FFFFFF
    BorderColor GRAY
}