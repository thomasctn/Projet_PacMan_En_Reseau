@startuml
!include theme.puml

actor Joueur
participant Client
participant Serveur

== Connexion ==
Joueur -> Client : lancer jeu
Client -> Serveur : connexion
activate Serveur
Serveur -> Serveur : assigner ID
Serveur --> Client : ID client, liste salons
deactivate Serveur
Client -> Client : changer scène (menu)
activate Client
deactivate Client
== Hall ==

Client -> Serveur : rejoindre salon
activate Serveur
Serveur -> Serveur : traiter demande
Serveur --> Client : paramètres, liste des joueurs
deactivate Serveur
Client -> Client : changer scène (salon)
activate Client
deactivate Client
@enduml