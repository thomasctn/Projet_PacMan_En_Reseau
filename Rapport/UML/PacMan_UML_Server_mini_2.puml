@startuml
' Mise en page
left to right direction

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam ArrowColor #333333
skinparam ArrowThickness 1
skinparam ClassFontSize 12
skinparam ClassFontName Arial
skinparam ClassBackgroundColor #fdfdfd
skinparam ClassBorderColor #444444
!include theme.puml

' =======================
' Classes principales
' =======================

rectangle "Serveur" {

class ServerNetwork {
}

class Lobby {
}

class Room {
}
}
rectangle "Jeu" {

class Game {
}

class Board {
}

class Player {
}
}
rectangle "Bot" {

class BotManager {
}

class BotController {
}

class GraphTraceMap {
}
}
class InputQueue {
}


' =======================
' Relations
' =======================

' Composition (l’objet appartient au parent)
ServerNetwork "1" *-- "1" Lobby

Lobby "1" *-- "0..*" Room

Room "1" *-- "0..1" Game
Room "1" *-- "1" BotManager
Room "1" *-- "1" InputQueue

Game "1" *-- "1" Board
Game "1" *-- "1..*" Player

BotManager "1" *-- "0..*" BotController
BotManager "1" *-- "1" GraphTraceMap
' Association / dépendance

BotController "0..*" --> "1" Game


' Liens invisibles pour éviter étirement horizontal
ServerNetwork -[hidden]- Game
Room -[hidden]- BotController
GraphTraceMap -[hidden]- Lobby

InputQueue -[hidden]- ServerNetwork
InputQueue -[hidden]- BotManager









@enduml
